<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Needed for CLRTestEnvironmentVariable, CLRTestTargetUnsupported, and GCStressIncompatible -->
    <RequiresProcessIsolation>true</RequiresProcessIsolation>
    <!-- The merge is a feature of the CoreCLR GC with regions, which a 32-bit process does not use -->
    <CLRTestTargetUnsupported Condition="'$(RuntimeFlavor)' != 'coreclr' or '$(TargetArchitecture)' == 'arm' or '$(TargetArchitecture)' == 'x86' or '$(TargetArchitecture)' == 'wasm'">true</CLRTestTargetUnsupported>
    <!-- The test counts what its own GCs leave, which GCStress changes -->
    <GCStressIncompatible>true</GCStressIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="StringDedupMerge.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(TestLibraryProjectPath)" />
  </ItemGroup>
  <ItemGroup>
    <CLRTestEnvironmentVariable Include="DOTNET_GCStringDedupMerge" Value="1" />
  </ItemGroup>
</Project>
